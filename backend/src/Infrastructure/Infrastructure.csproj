<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <!-- Pinned to the last Apache-2.0 release line — 3.1+/4.x moved to the
         Six Labors Split License, which requires a paid commercial license
         outside narrow free-tier cases. Not something to carry silently in
         a portfolio project meant to be run/deployed freely. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.11" />
    <!-- AI/RAG (docs/decisions/ADR-005, ADR-003). Google.GenAI is Google's
         official .NET Gemini SDK; .AsIChatClient()/.AsIEmbeddingGenerator()
         adapt it to Microsoft.Extensions.AI's provider-neutral interfaces
         (IChatClient / IEmbeddingGenerator<string, Embedding<float>>), which
         is what the rest of this codebase actually depends on — not the
         Gemini SDK directly. Microsoft.Agents.AI supplies AIFunctionFactory
         and IChatClient.AsAIAgent(...) for tool-calling. Combination
         verified against .NET 10 + SQL Server 2025's native vector type in
         a separate reference project before adopting it here. -->
    <PackageReference Include="Google.GenAI" Version="1.21.1" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.21.0" />
    <PackageReference Include="CommunityToolkit.VectorData.SqlServer" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed for IHttpContextAccessor (HttpTenantContext) — Infrastructure
         is allowed to depend on ASP.NET Core; only Domain is not. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ships with the assembly (docs/architecture — product color
         extraction), not user data, so it's Content/CopyToOutputDirectory
         like any other bundled asset, not something read from
         STORAGE_LOCAL_PATH. -->
    <Content Include="ColorExtraction\Models\dominant_color.onnx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
