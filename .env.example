# Copy this file to .env and fill in real local values. NEVER commit .env.
# This file documents every variable name the system expects; values here are placeholders only.

# --- Database ---
# Host port 1434, not 1433 — see deployment/docker-compose.yml (leaves the
# default SQL Server port free for a locally-installed instance or another
# project's container). MSSQL_SA_PASSWORD below must match this password.
DB_CONNECTION_STRING=Server=localhost,1434;Database=QuickStock;User Id=sa;Password=__CHANGE_ME__;TrustServerCertificate=True
MSSQL_SA_PASSWORD=__CHANGE_ME__

# --- Auth / JWT ---
JWT_SIGNING_KEY=__GENERATE_A_STRONG_RANDOM_SECRET__
JWT_ISSUER=quickstock-api
JWT_AUDIENCE=quickstock-client
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14

# --- Web client ---
# NOTE: Next.js does NOT read this root .env file — it only auto-loads
# env files from web/'s own directory. This value is documentation of
# what's needed; the actual value lives in web/.env.local (gitignored,
# not this file). Keep them in sync manually.
# Port 5292 is the HTTP endpoint — NOT 7223 (HTTPS-only; a plain http://
# request to it gets ERR_EMPTY_RESPONSE, see docs/operations/troubleshooting.md).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5292

# --- AI (required from Phase 5 onward) ---
OPENAI_API_KEY=__YOUR_OPENAI_API_KEY__

# --- File storage ---
STORAGE_PROVIDER=local           # local | azureBlob
STORAGE_LOCAL_PATH=./.data/documents
AZURE_BLOB_CONNECTION_STRING=    # only required when STORAGE_PROVIDER=azureBlob

# --- Azure (Phase 4 onward, cloud environments only) ---
AZURE_KEY_VAULT_URI=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- CORS ---
# Comma-separated. Next.js picks whatever port is free starting at 3000,
# so both are listed by default (see docs/operations/troubleshooting.md) —
# only relevant for docker-compose; `dotnet run`/F5 don't read this file
# at all (no .env loader wired up for plain ASP.NET Core) and fall back
# to Program.cs's own default, which lists the same two ports.
ALLOWED_WEB_ORIGIN=http://localhost:3000,http://localhost:3001

# --- Rate limiting (Phase 3, docs/security/security-model.md) ---
# Applies to every /api/v1/auth/* endpoint. Optional — Program.cs
# defaults to 10 requests/60 seconds per client IP if unset.
RATE_LIMIT_AUTH_PERMIT_LIMIT=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
